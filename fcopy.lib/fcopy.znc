// --------------
//  fcopy
// -------- v0.0.1

#ifndef FCOPY__
const byte FCOPY__=1;

include "/zdev/fileio.znc";

byte fcopy(char* src, char* dest) {

  byte shandle = fopen(src, M_READ);
  if(errno !=0) {
    return errno;
  }
  byte dhandle = fopen(dest, M_CREATE);
  if(errno !=0) {
    fclose(shandle);
    return errno;
  }
  
  char[2048] buffer;
  int len = 2048;
  while (len==2048) {
    len = fread(shandle, buffer, len);
    
    fwrite(dhandle, buffer, len);
  }
  
  fclose(shandle);
  fclose(dhandle);
  return 0;
}

#endif