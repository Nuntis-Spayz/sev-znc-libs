#ifndef MOUSE__
const byte MOUSE__=0x01;

byte readMouseX() __asm__ {
  ld bc,0xFBDF
  in l,(c)
  ld h,0
  ret
}

byte readMouseY() __asm__ {
  ld bc,0xFFDF
  in l,(c)
  ld h,0
  ret
}

byte readMouseB() __asm__ {
  ld bc,0xFADF
  in a,(c)
  and 0x07
  ld l,a
  ld h,0
  ret
}

byte readMouseW() __asm__ {
  ld bc,0xFADF
  in a,(c)
  and 0xF8
  rra
  rra
  rra
  ld h,0
  ld l,a 
  ret
}
#endif
