#ifndef STDAYOFMTH__
const byte STDAYOFMTH__=0x01;

int startDayOfMonth(int year, int month) {
  // adjust month and year for Zeller's Congruence
  if(month <3) {
    month = month + 12;
    year = year -1;
  }
  
  int k =year % 100;
  int j= year / 100;
  
  // Zeller's Congruence formula
  int d = (1 +(13 * (month+1))/5 + k + (k/4) + (j/4) - (2*j)) % 7;

  return (d + 5) %7 ;
}
