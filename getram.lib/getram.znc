#ifndef GETRAM__
const byte GETRAM__=1;

int getFreeBanks() {
  __asm__
  {
    ld hl,23401
    ld l,(hl)
    ld h,0
  }
}

int getRam() {
  __asm__
  {
    push af
    push de

    ; HL = freeBanks = (byte at 23401), with H=0
    ld   hl,23401
    ld   l,(hl)
    ld   h,0

    ; HL = freeBanks + 17
    ld   de,17
    add  hl,de

    ; quotient in A
    xor  a

div47:
    ld   de,47
    or   a          ; clear carry for SBC
    sbc  hl,de      ; try HL -= 47
    jr   c,done
    inc  a
    jr   div47

done:
    add  hl,de      ; restore remainder >= 0

    ; return quotient in HL
    ld   h,0
    ld   l,a

    pop  de
    pop  af
  }
}

#endif
