#ifndef GETRAM__
const byte GETRAM__=1;

int getFreeBanks() {
  __asm__ {  
    ld a, (23401)
    ld h, 0
    ld l,a
  }
}

int getRam() {
  return (getFreeBanks()+17)/47;
}

#endif
