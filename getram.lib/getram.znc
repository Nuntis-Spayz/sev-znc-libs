#ifndef GETRAM__
const byte GETRAM__=1;

int getFreeBanks() {
  __asm__
  {
    push af

    ld a,(23401)
    ld l,a
    ld h,0

    pop af
  }
}

int getRam()
{
  __asm__
  {
    push af

    ; a = freeBanks = (byte at 23401)
    ld   a,(23401)

    ;/2 >> 1 so that the byte won't overflow on a ks3
    srl  a          ; >>1
    ; a = freeBanks + 9 (17)
    add  a,9

    ; A = a >> 5 (6) (i.e., divide by 33 [64]), unsigned
    ; 16k banks, 16 * 64 = 1024
    srl  a          ; >>2
    srl  a          ; >>3
    srl  a          ; >>4
    srl  a          ; >>5
    srl  a          ; >>6

    ; return quotient in HL
    ld   h,0
    ld   l,a

    pop  af
  }
}

#endif
